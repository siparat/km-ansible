COMMON_DATABASE="postgresql://{{ env.common_db.user }}:{{ env.common_db.password }}@{{ env.common_db.host }}:{{ env.common_db.port }}/{{ env.common_db.database }}"
MOVIES_DATABASE="postgresql://{{ env.movies_db.user }}:{{ env.movies_db.password }}@{{ env.movies_db.host }}:{{ env.movies_db.port }}/{{ env.movies_db.database }}"

SALT=7

ACCESS_TOKEN_SECRET="{{ env.api.access_token }}"
REFRESH_TOKEN_SECRET="{{ env.api.refresh_token }}"

ACCESS_TOKEN_EXPIRIES=15
REFRESH_TOKEN_EXPIRIES=1440

EMAIL_CHANGE_PERIOD=30
LOGIN_CHANGE_PERIOD=14

LIMIT_MOVIES_PER_REQUEST=25
LIMIT_COMMENTS_PER_REQUEST=6
