SMTP_PASS="{{ env.api.smpt_pass }}"
SMTP_USER="{{ env.api.smpt_user }}"

SUPPORT_EMAIL="{{ env.email_support }}"
REPORT_EMAIL="{{ env.email_report }}"

SENTRY_DSN="{{ env.api.sentry_dsn }}"

DOMAIN="{{ env.https_host }}"

TELEGRAM_BOT_TOKEN="{{ env.api.telegram_bot_token }}"
TELEGRAM_CHAT_ID="{{ env.api.telegram_chat_id }}"
