http {
	server {
		listen 2002;
		location / {
			add_header Content-Type text/plain;
			return 200 {{ env.https_host }};
		}
	}

	server {
		listen 443 ssl;
		server_name {{ env.domain }};

		ssl_certificate /etc/letsencrypt/live/{{ env.domain }}/fullchain.pem;
		ssl_certificate_key /etc/letsencrypt/live/{{ env.domain }}/privkey.pem;

		location /upload/posters/ {
			alias /etc/posters/;
			expires 7d;
		}

		location /upload {
			proxy_pass http://api:3000/upload;
		}

		location /api {
			proxy_pass http://api:3000/api;
		}

		location / {
			proxy_pass http://app:3001;
		}

		location /ws {
			proxy_pass http://api:3000/ws;
			proxy_http_version 1.1;
			proxy_set_header Upgrade $http_upgrade;
			proxy_read_timeout 86400s;
			proxy_send_timeout 86400s;
			proxy_set_header Connection "upgrade";
		}

		error_page 502 /502.html;

		location /502.html {
			root /var/www/errors;
			internal;
		}
	}

	server {
		listen 80;
		server_name grafana.{{ env.domain }};

		return 301 grafana.{{ env.https_host }}$request_uri;
	}

	server {
		listen 443 ssl;
		server_name grafana.{{ env.domain }};

		ssl_certificate /etc/letsencrypt/live/grafana.{{ env.domain }}/fullchain.pem;
		ssl_certificate_key /etc/letsencrypt/live/grafana.{{ env.domain }}/privkey.pem;
		
		location / {
			proxy_pass http://grafana:3000;
		}
	}

	server {
		listen 4000;

		return 301 {{ env.https_host }}$request_uri;
	}

	server {
		listen 80;

		return 301 {{ env.https_host }}$request_uri;
	}
}

events {
	worker_connections 4096;
}